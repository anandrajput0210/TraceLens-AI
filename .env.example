# Optional Gemini explanations. Leave blank for deterministic-only scanning.
GEMINI_API_KEY=
TRACELENS_AI_MODEL=gemini-3.5-flash-lite

# Optional comma-separated frontend origins for a non-local deployment.
TRACELENS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend browser URL; baked into the frontend image at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
